# Copy to .env.local and fill in. Never commit .env.local.
OPENAI_API_KEY=

# Secret used to sign auction results so prices can't be faked. Any long random string.
SIGNING_SECRET=

# Gallery storage (Upstash Redis). On Vercel these are added automatically when you
# connect "Upstash for Redis" from Storage. Without them, local dev saves to .data/gallery.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional overrides
# OPENAI_JUDGE_MODEL=gpt-5.4-mini
# OPENAI_JUDGE_REASONING=low   # set to "off" for models without reasoning
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_QUALITY=low     # low | medium | high
